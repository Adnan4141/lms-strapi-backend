{
  "kind": "collectionType",
  "collectionName": "quiz_attempts",
  "info": {
    "singularName": "quiz-attempt",
    "pluralName": "quiz-attempts",
    "displayName": "QuizAttempt",
    "description": "Quiz Attempt Content Type"
  },
  "options": {
    "draftAndPublish": true
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    },
    "score": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0
    },
    "totalQuestions": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0
    },
    "answers": {
      "type": "json",
      "required": true
    },
    "submittedAt": {
      "type": "datetime"
    }
  }
}
