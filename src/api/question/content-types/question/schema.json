{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true,
      "minLength": 3
    },
    "options": {
      "type": "json",
      "required": true
    },
    "correctAnswer": {
      "type": "integer",
      "required": true,
      "min": 0,
      "private": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions",
      "required": true
    }
  }
}
